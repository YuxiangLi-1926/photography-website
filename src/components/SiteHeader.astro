---
import { navigationLinks, site } from '../data/site';
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const isActive = (href: string) => href === '/work/' ? currentPath !== '/contact/' : currentPath.startsWith(href);
---
<header class="portfolio-header">
  <a class="portfolio-brand" href="/" aria-label={site.name + ' home'}>Yuxiang Li<span>Photography</span></a>
  <nav class="portfolio-desktop-nav" aria-label="Main navigation">
    {navigationLinks.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.title}</a>)}
  </nav>
</header>
