---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contact | Yuxiang Li Photography" description="Contact Yuxiang Li for photography, collaborations and commissions in London." mainClass="portfolio-shell">
  <section class="portfolio-contact" aria-labelledby="contact-heading">
    <div class="portfolio-contact__intro">
      <p class="portfolio-eyebrow">Contact / London</p>
      <h1 id="contact-heading">Let's make<br />something together.</h1>
      <p>For photography commissions, collaborations, or simply to say hello.</p>
      <a class="contact-work-link" href="/work/">Explore my work <span aria-hidden="true">↗</span></a>
    </div>
    <div class="contact-details">
      <h2>Get in touch</h2>
      <dl>
        <div class="contact-email-row">
          <dt>Email</dt>
          <dd>
            <a class="portfolio-email" href={`mailto:${site.email}`}>
              <span>{site.email.split('@')[0]}<wbr />@{site.email.split('@')[1]}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </dd>
        </div>
        <div class="contact-social-row"><dt>WeChat</dt><dd>hdssslyx</dd></div>
        <div class="contact-social-row"><dt>小红书 / Xiaohongshu</dt><dd>hdssslyx</dd></div>
      </dl>
      <p class="contact-note">For enquiries, include the shoot date, location and a short outline of your project.</p>
    </div>
  </section>
</BaseLayout>
