---
import CategoryGalleryPage from '../components/CategoryGalleryPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPhotosByCategory } from '../lib/gallery';

const photos = getPhotosByCategory('event');
---

<BaseLayout title="Event | Yuxiang Li Photography" description="Event photography placeholder page.">
  <CategoryGalleryPage
    title="Event"
    description="Event photography galleries, selected stories, and commissioned coverage."
    photos={photos}
  />
</BaseLayout>
