---
import CategoryGalleryPage from '../components/CategoryGalleryPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPhotosByCategory } from '../lib/gallery';

const photos = getPhotosByCategory('nightlife');
---

<BaseLayout title="Nightlife | Yuxiang Li Photography" description="Nightlife photography placeholder page.">
  <CategoryGalleryPage
    title="Nightlife"
    description="Nightlife images, venue stories, and low-light photography sets."
    photos={photos}
  />
</BaseLayout>
