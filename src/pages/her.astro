<BaseLayout title="Her | Yuxiang Li Photography" description="Dedicated personal gallery placeholder page.">
  <CategoryGalleryPage
    title="Her"
    description="A dedicated personal gallery with carefully selected image sets."
    photos={photos}
  />
</BaseLayout>
