---
import CategoryGalleryPage from '../components/CategoryGalleryPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPhotosByCategory } from '../lib/gallery';

const photos = getPhotosByCategory('portrait');
---

<BaseLayout title="Portrait | Yuxiang Li Photography" description="Portrait photography placeholder page.">
  <CategoryGalleryPage
    title="Portrait"
    description="Individual portraits, editorial portraits, and personal sessions."
    photos={photos}
  />
</BaseLayout>
