---
import CategoryGalleryPage from '../components/CategoryGalleryPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPhotosByCategory } from '../lib/gallery';

const photos = getPhotosByCategory('my-work');
---

<BaseLayout title="My Work | Yuxiang Li Photography" description="Selected photography work placeholder page.">
  <CategoryGalleryPage
    title="My Work"
    description="Selected projects, featured shoots, and portfolio highlights."
    photos={photos}
  />
</BaseLayout>
