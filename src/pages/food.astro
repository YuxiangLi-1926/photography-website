---
import CategoryGalleryPage from '../components/CategoryGalleryPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPhotosByCategory } from '../lib/gallery';

const photos = getPhotosByCategory('food');
---

<BaseLayout title="Food | Yuxiang Li Photography" description="Food photography placeholder page.">
  <CategoryGalleryPage
    title="Food"
    description="Restaurant, editorial, and product-focused food photography."
    photos={photos}
  />
</BaseLayout>
