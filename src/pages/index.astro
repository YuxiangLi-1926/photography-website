---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedWork from '../components/home/FeaturedWork.astro';
import HomeContact from '../components/home/HomeContact.astro';
import HomeHer from '../components/home/HomeHer.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeIntro from '../components/home/HomeIntro.astro';
import HomeMyWork from '../components/home/HomeMyWork.astro';
import { contactLinks, homepageCategories } from '../data/site';
import {
  getFeaturedPhotos,
  getFeaturedPhotosByCategory,
  getFirstFeaturedPhotoByCategory,
} from '../lib/gallery';

const heroPhoto = getFeaturedPhotos()[0];
const herPhoto = getFirstFeaturedPhotoByCategory('her');
const myWorkPhotos = getFeaturedPhotosByCategory('my-work');
---

<BaseLayout
  title="Home | Yuxiang Li Photography"
  description="Yuxiang Li is a photographer in London, photographing people, events, places and the moments worth keeping."
  bodyClass="home-page"
  mainClass="home-shell"
>
  <HomeHero photo={heroPhoto} />
  <HomeIntro />
  <FeaturedWork categories={homepageCategories} />
  <HomeHer photo={herPhoto} />
  <HomeMyWork photos={myWorkPhotos} />
  <HomeContact links={contactLinks} />
</BaseLayout>
