---
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/portfolio.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
  mainClass?: string;
}

const {
  title = site.name,
  description = site.description,
  bodyClass,
  mainClass = 'page-shell',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body id="top" class:list={['portfolio-page', bodyClass]}>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main class={mainClass}>
      <slot />
    </main>
    <footer class="portfolio-footer"><a href="/">Yuxiang Li Photography</a><a href="/contact/">Get in touch ↗</a><a href="#top">Back to top ↑</a></footer>
  </body>
</html>
